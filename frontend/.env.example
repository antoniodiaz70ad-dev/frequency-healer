# Public flags require rebuild. Defaults are OFF; set only for local or preview.
NEXT_PUBLIC_HARMONIC_LAB_ENABLED=true
NEXT_PUBLIC_VOICE_JOURNEY_ENABLED=true
# Server only. Local parser remains available.
VOICE_AI_ENABLED=false
# Optional HTTPS transcription adapter: multipart file/language/max_duration_seconds -> {"text":"..."}
VOICE_TRANSCRIPTION_URL=
VOICE_TRANSCRIPTION_TOKEN=
# Optional HTTPS intent adapter: JSON {instruction,transcript} -> exact ParsedIntentionV1 JSON
VOICE_INTENT_URL=
VOICE_INTENT_TOKEN=

# ATENEA staging preparation: keep gates off; NEVER put real secrets in this tracked example.
ATENEA_VOICE_ENABLED=false
ATENEA_STAGING_ENABLED=false
ATENEA_LIVE_ENABLED=false
ATENEA_LIVE_REVIEWED=false
ATENEA_REAPER_READY=false
ATENEA_VOICE_ORIGIN=
ATENEA_LOGIN_PATH=
ATENEA_AUTH_ISSUER=
ATENEA_AUTH_AUDIENCE=
ATENEA_AUTH_JWKS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ATENEA_REAPER_TOKEN=
OPENAI_API_KEY=

# Identity-only check; does NOT issue the app cookie or unlock real voice.
# Separate project from production; all values are server config, never real secrets here.
ATENEA_STAGING_IDENTITY_PROVIDER=
ATENEA_STAGING_ACCESS_ENABLED=false
ATENEA_STAGING_AUTH_REVIEWED=false
ATENEA_LOCAL_STAGING=false
ATENEA_SUPABASE_URL=
ATENEA_SUPABASE_PUBLISHABLE_KEY=
ATENEA_PRODUCTION_SUPABASE_REFS=
ATENEA_STAGING_ALLOWED_SUBJECTS=

# Reviewed provider -> persistent HttpOnly app session; independent of voice gates.
ATENEA_STAGING_SESSION_ENABLED=false
